{
  "seed": 42,
  "num_seeds": 5,
  "seeds": [
    42,
    137,
    256,
    512,
    1024
  ],
  "deterministic": true,
  "device": "auto",
  "drift": {
    "num_reference_points": 512,
    "reference_batch_size": 128,
    "norm_type": "l2",
    "epsilon_init": 1.0,
    "epsilon_min": 0.01,
    "epsilon_max": 10.0,
    "lambda_init": 0.5,
    "lambda_lr": 0.05,
    "lambda_max": 50.0
  },
  "epsilon_scheduler": {
    "type": "cosine",
    "warmup_steps": 50,
    "decay_rate": 0.995,
    "uncertainty_scale": 1.0
  },
  "training": {
    "optimizer": "adam",
    "lr": 0.001,
    "weight_decay": 0.0,
    "batch_size": 128,
    "epochs": 50,
    "grad_clip": 1.0
  },
  "experiment_a": {
    "name": "continual_cifar",
    "dataset_sequence": [
      "cifar10",
      "cifar100"
    ],
    "model": "resnet18_small",
    "epochs_per_task": 15,
    "lr": 0.001,
    "batch_size": 128,
    "num_tasks": 5,
    "ewc_lambda": 400.0,
    "drift_epsilon": 1.0,
    "drift_lambda": 0.5
  },
  "si": {
    "c": 0.5
  },
  "lwf": {
    "alpha": 1.0,
    "temperature": 2.0
  },
  "replay": {
    "buffer_size": 500,
    "batch_size": 32
  },
  "distillation": {
    "lambda": 1.0
  },
  "mnist": {
    "num_tasks": 10,
    "batch_size": 256,
    "epochs_per_task": 10
  },
  "cifar100": {
    "num_tasks": 10
  },
  "experiment_b": {
    "name": "transformer_algorithmic",
    "tasks": [
      "copy",
      "reverse",
      "sort"
    ],
    "model": {
      "d_model": 64,
      "nhead": 4,
      "num_layers": 2,
      "dim_feedforward": 128,
      "max_seq_len": 32,
      "vocab_size": 16
    },
    "epochs_per_task": 50,
    "lr": 0.0005,
    "batch_size": 64,
    "drift_epsilon": 0.3,
    "drift_lambda": 0.5
  },
  "experiment_c": {
    "name": "rl_gridworld",
    "grid_size": 8,
    "model": {
      "hidden_dim": 64,
      "num_layers": 2
    },
    "episodes": 2000,
    "lr": 0.001,
    "gamma": 0.99,
    "drift_epsilon": 0.5,
    "drift_lambda": 0.5,
    "kl_coeff": 0.01
  },
  "metrics": {
    "log_interval": 10,
    "eval_interval": 50,
    "save_checkpoints": true,
    "checkpoint_interval": 500
  },
  "visualization": {
    "dpi": 300,
    "figsize": [
      8,
      6
    ],
    "style": "seaborn-v0_8-whitegrid",
    "colorblind_palette": true,
    "export_pdf": true,
    "font_size": 12
  },
  "logging": {
    "use_wandb": false,
    "project_name": "functional-trust-regions",
    "log_dir": "logs",
    "save_dir": "results"
  }
}